# editor / OS
.DS_Store
*.o
__pycache__/
*.pyc

# agent worktrees
.claude/worktrees/

# cargo
rust-modules/target/
rust-modules/target-*/

# `make` output: the staged app directory
/dist/

# Bundled FFmpeg and libass: upstream sources and build output, all reproduced by
# ci/build-ffmpeg.sh and ci/build-libass.py from sha256-pinned tarballs. No trailing slash, so a
# symlink to a shared build is ignored as well as a real directory.
vendor/ffmpeg-build
vendor/ffmpeg-build-host
vendor/ffmpeg-prefix-host
vendor/libass-sources
vendor/libass-build-host
vendor/libass-prefix-host
pkg/libass-plx-host.so.0*

# Generated test media; only the one small regression fixture is tracked.
tests/fixtures/**/*.mkv
!tests/fixtures/mkv_zlib_subs.mkv

# design/ demo library media (generated)
design/demo-library/library/
design/demo-library/sources/*.mp4
